name: Package

on:
  pull_request:
  push:
    branches:
      - main
      - master
    tags:
      - "v*"
  workflow_dispatch:

permissions:
  contents: read

jobs:
  package:
    runs-on: ubuntu-latest
    timeout-minutes: 20

    steps:
      - name: Check out source
        uses: actions/checkout@v7
        with:
          persist-credentials: false

      - name: Set up Python
        uses: actions/setup-python@v7
        with:
          python-version: "3.12"
          check-latest: false

      - name: Install packaging tools
        run: python -m pip install --upgrade pip setuptools wheel

      - name: Compile source
        run: python -m compileall -q src tests

      - name: Build wheel
        run: python -m pip wheel --no-deps --no-build-isolation --wheel-dir dist .

      - name: Verify wheel contents
        shell: bash
        run: |
          set -Eeuo pipefail
          wheel="$(find dist -maxdepth 1 -type f -name 'mt_media_sdk-*.whl' -print -quit)"
          if [[ -z "${wheel}" ]]; then
            echo "::error::mt-media-sdk wheel was not produced"
            exit 2
          fi
          python scripts/verify_distribution.py "${wheel}"

      - name: Verify isolated install and import
        shell: bash
        run: |
          set -Eeuo pipefail
          wheel="$(find dist -maxdepth 1 -type f -name 'mt_media_sdk-*.whl' -print -quit)"
          python -m venv .package-test-venv
          .package-test-venv/bin/python -m pip install --no-deps "${wheel}"
          .package-test-venv/bin/python -c \
            "import mt_media_sdk; print(mt_media_sdk.__file__)"
